# API-ключи по ролям: роль:ключ через запятую. В продакшене — длинные случайные значения.
API_KEYS=integration:demo-integration-key,analyst:demo-analyst-key,admin:demo-admin-key
# Секрет подписи вебхуков (HMAC-SHA256, заголовок X-Signature)
WEBHOOK_SECRET=demo-webhook-secret
# Бюджет времени на ML внутри одного запроса, мс (сверх — ответ по правилам, degraded=true)
ML_BUDGET_MS=120
# Хранилище инцидентов и журнала (в продакшене — PostgreSQL)
DB_PATH=data/fraud.db
# Папка для автоматической загрузки стоп-листов и период опроса, с
LISTS_INBOX=lists/inbox
LISTS_POLL_SEC=30
# Демо-режим: встроенный приёмник вебхуков, сценарии, прогрев панели вымышленным потоком
DEMO_MODE=1
DEMO_WARMUP=1
PUBLIC_BASE_URL=http://127.0.0.1:8000
